COLORREF GetBirdColor(int type, int shade) {
    switch (type) {
        case BIRD_YELLOW:
            if (shade == 0) return RGB(255, 220, 50);
            if (shade == 1) return RGB(255, 245, 150);
            return RGB(210, 160, 20);
        case BIRD_RED:
            if (shade == 0) return RGB(240, 90, 90);
            if (shade == 1) return RGB(255, 160, 160);
            return RGB(180, 40, 40);
        case BIRD_BLUE:
            if (shade == 0) return RGB(100, 180, 255);
            if (shade == 1) return RGB(180, 220, 255);
            return RGB(40, 100, 200);
        case BIRD_GREEN:
            if (shade == 0) return RGB(120, 220, 100);
            if (shade == 1) return RGB(180, 240, 170);
            return RGB(50, 150, 40);
        case BIRD_PURPLE:
            if (shade == 0) return RGB(190, 130, 255);
            if (shade == 1) return RGB(230, 190, 255);
            return RGB(120, 60, 190);
    }
    return RGB(255, 220, 50);
}

int GetMedalType(int score) {
    if (score >= 40) return MEDAL_PLATINUM;
    if (score >= 30) return MEDAL_GOLD;
    if (score >= 20) return MEDAL_SILVER;
    if (score >= 10) return MEDAL_BRONZE;
    return MEDAL_NONE;
}

wstring GetMedalName(int medal) {
    switch (medal) {
        case MEDAL_BRONZE:   return L"Бронза";
        case MEDAL_SILVER:   return L"Серебро";
        case MEDAL_GOLD:     return L"Золото";
        case MEDAL_PLATINUM: return L"Платина";
        default:             return L"Без медали";
    }
}

COLORREF GetMedalColor(int medal) {
    switch (medal) {
        case MEDAL_BRONZE:   return RGB(205, 127, 50);
        case MEDAL_SILVER:   return RGB(192, 192, 192);
        case MEDAL_GOLD:     return RGB(255, 215, 0);
        case MEDAL_PLATINUM: return RGB(229, 228, 226);
        default:             return RGB(150, 150, 150);
    }
}

wstring GetDifficultyName(int diff) {
    switch (diff) {
        case 0: return L"Легко";
        case 1: return L"Обычно";
        case 2: return L"Сложно";
    }
    return L"Обычно";
}

