void RenderUI(HDC hdc) {
    switch (g_state) {
        case STATE_MENU:
            RenderMenu(hdc);
            break;
        case STATE_PLAYING:
        case STATE_PAUSED:
            RenderScore(hdc);
            RenderScorePopup(hdc);
            break;
        case STATE_DYING:
            RenderScore(hdc);
            break;
        case STATE_GAME_OVER:
            RenderScore(hdc);
            RenderGameOver(hdc);
            break;
    }

    if (g_showSettings) RenderSettings(hdc);

    if (g_state == STATE_PAUSED) {
        RECT pauseRc = {GAME_X, GAME_Y, GAME_X + GAME_W, GAME_Y + GAME_H};
        DrawFilledRect(hdc, pauseRc, RGB(30, 30, 50));
        RECT textRc = {GAME_X, GAME_Y + GAME_H / 2 - 40, GAME_X + GAME_W, GAME_Y + GAME_H / 2 + 40};
        DrawTextC(hdc, textRc, L"ПАУЗА", RGB(255, 255, 255), g_fontHuge,
                  DT_CENTER | DT_VCENTER | DT_SINGLELINE);
    }
}

void RenderFrame() {
    if (!g_memDC) return;

    RECT fullRc = {0, 0, g_memW, g_memH};
    DrawGradientV(g_memDC, fullRc, RGB(40, 40, 60), RGB(20, 20, 30));

    int shakeX = 0, shakeY = 0;
    if (g_shakeTimer > 0 && g_shakeIntensity > 0) {
        shakeX = (rand() % (int)(g_shakeIntensity * 2)) - (int)g_shakeIntensity;
        shakeY = (rand() % (int)(g_shakeIntensity * 2)) - (int)g_shakeIntensity;
    }

    POINT oldOrg;
    SetViewportOrgEx(g_memDC, GAME_X + shakeX, GAME_Y + shakeY, &oldOrg);

    RenderBackground(g_memDC);
    RenderPipes(g_memDC);
    RenderBird(g_memDC);
    RenderGround(g_memDC);
    RenderParticles(g_memDC);

    SetViewportOrgEx(g_memDC, oldOrg.x, oldOrg.y, nullptr);

    RenderUI(g_memDC);

    if (g_flashTimer > 0) {
        RECT flashRc = {GAME_X, GAME_Y, GAME_X + GAME_W, GAME_Y + GAME_H};
        int alpha = (int)(g_flashTimer * 1500);
        if (alpha > 255) alpha = 255;
        for (int y = 0; y < GAME_H; y++) {
            RECT line = {GAME_X, GAME_Y + y, GAME_X + GAME_W, GAME_Y + y + 1};
            DrawFilledRect(g_memDC, line, RGB(255, 255, 255 - alpha / 4));
        }
    }
}

