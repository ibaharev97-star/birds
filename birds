void DrawFilledRect(HDC hdc, RECT rc, COLORREF c) {
    HBRUSH br = CreateSolidBrush(c);
    FillRect(hdc, &rc, br);
    DeleteObject(br);
}

void DrawGradientV(HDC hdc, RECT rc, COLORREF top, COLORREF bottom) {
    int h = rc.bottom - rc.top;
    if (h <= 0) return;
    for (int y = 0; y < h; y++) {
        float t = (float)y / h;
        int r = (int)(GetRValue(top) + (GetRValue(bottom) - GetRValue(top)) * t);
        int g = (int)(GetGValue(top) + (GetGValue(bottom) - GetGValue(top)) * t);
        int b = (int)(GetBValue(top) + (GetBValue(bottom) - GetBValue(top)) * t);
        RECT line = {rc.left, rc.top + y, rc.right, rc.top + y + 1};
        DrawFilledRect(hdc, line, RGB(r, g, b));
    }
}

void DrawRoundedRect(HDC hdc, RECT rc, int radius, COLORREF c) {
    HBRUSH br = CreateSolidBrush(c);
    HPEN pen = CreatePen(PS_NULL, 0, c);
    HGDIOBJ ob = SelectObject(hdc, br);
    HGDIOBJ op = SelectObject(hdc, pen);
    RoundRect(hdc, rc.left, rc.top, rc.right, rc.bottom, radius, radius);
    SelectObject(hdc, ob);
    SelectObject(hdc, op);
    DeleteObject(br);
    DeleteObject(pen);
}

void DrawCircle(HDC hdc, int cx, int cy, int radius, COLORREF c) {
    if (radius <= 0) return;
    HBRUSH br = CreateSolidBrush(c);
    HPEN pen = CreatePen(PS_NULL, 0, c);
    HGDIOBJ ob = SelectObject(hdc, br);
    HGDIOBJ op = SelectObject(hdc, pen);
    Ellipse(hdc, cx - radius, cy - radius, cx + radius, cy + radius);
    SelectObject(hdc, ob);
    SelectObject(hdc, op);
    DeleteObject(br);
    DeleteObject(pen);
}

void DrawEllipseRect(HDC hdc, RECT rc, COLORREF c) {
    HBRUSH br = CreateSolidBrush(c);
    HPEN pen = CreatePen(PS_NULL, 0, c);
    HGDIOBJ ob = SelectObject(hdc, br);
    HGDIOBJ op = SelectObject(hdc, pen);
    Ellipse(hdc, rc.left, rc.top, rc.right, rc.bottom);
    SelectObject(hdc, ob);
    SelectObject(hdc, op);
    DeleteObject(br);
    DeleteObject(pen);
}

void DrawTextC(HDC hdc, RECT rc, const wstring& s, COLORREF c, HFONT f, UINT fmt) {
    SetBkMode(hdc, TRANSPARENT);
    SetTextColor(hdc, c);
    HGDIOBJ of = SelectObject(hdc, f);
    DrawTextW(hdc, s.c_str(), -1, &rc, fmt);
    SelectObject(hdc, of);
}

void DrawTextShadow(HDC hdc, RECT rc, const wstring& s,
                    COLORREF c, COLORREF shadow, HFONT f, UINT fmt) {
    RECT r2 = rc;
    r2.left += 2;
    r2.top += 2;
    DrawTextC(hdc, r2, s, shadow, f, fmt);
    DrawTextC(hdc, rc, s, c, f, fmt);
}

