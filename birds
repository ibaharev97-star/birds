void InitGame(HWND hwnd) {
    g_hwnd = hwnd;
    SetupFonts();
    LoadSettings();

    HDC hdc = GetDC(hwnd);
    RECT rc;
    GetClientRect(hwnd, &rc);
    g_memW = rc.right;
    g_memH = rc.bottom;
    g_memDC = CreateCompatibleDC(hdc);

    BITMAPINFO bmi = {};
    bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
    bmi.bmiHeader.biWidth = g_memW;
    bmi.bmiHeader.biHeight = -g_memH;
    bmi.bmiHeader.biPlanes = 1;
    bmi.bmiHeader.biBitCount = 32;
    bmi.bmiHeader.biCompression = BI_RGB;

    void* bits = nullptr;
    g_memBitmap = CreateDIBSection(hdc, &bmi, DIB_RGB_COLORS, &bits, nullptr, 0);
    g_pixels = (uint32_t*)bits;

    SelectObject(g_memDC, g_memBitmap);
    ReleaseDC(hwnd, hdc);

    // Облака
    for (int i = 0; i < 15; i++) {
        Cloud c;
        c.x = (float)(rand() % GAME_W);
        c.y = 40.0f + (float)(rand() % 200);
        c.size = 0.5f + (rand() % 100) / 100.0f;
        c.layer = rand() % 3;
        c.speed = 0.2f + c.layer * 0.15f;
        g_clouds.push_back(c);
    }

    // Кусты
    for (int i = 0; i < 30; i++) {
        Bush b;
        b.x = (float)(rand() % (GAME_W + 100)) - 50;
        b.y = GAME_H - GROUND_HEIGHT + (float)(rand() % 20);
        b.size = 0.5f + (rand() % 100) / 100.0f;
        b.type = rand() % 3;
        g_bushes.push_back(b);
    }

    g_state = STATE_MENU;
    g_bestScore = g_stats.bestScore;
    ResetGame();

    SetTimer(hwnd, 1, 16, nullptr);
}

void ShutdownGame() {
    SaveSettings();

    if (g_fontTiny) DeleteObject(g_fontTiny);
    if (g_fontSmall) DeleteObject(g_fontSmall);
    if (g_fontMedium) DeleteObject(g_fontMedium);
    if (g_fontLarge) DeleteObject(g_fontLarge);
    if (g_fontHuge) DeleteObject(g_fontHuge);
    if (g_fontScore) DeleteObject(g_fontScore);
    if (g_fontBold) DeleteObject(g_fontBold);

    if (g_memBitmap) DeleteObject(g_memBitmap);
    if (g_memDC) DeleteDC(g_memDC);
}

void ResetGame() {
    g_bird.reset();
    g_bird.color = g_settings.birdColor;
    g_pipes.clear();
    g_particles.clear();
    g_pipeTimer = 0;
    g_score = 0;
    g_gameSpeed = 1.0f;
    g_groundOffset = 0;
    g_flashTimer = 0;
    g_shakeTimer = 0;
    g_shakeIntensity = 0;
    g_deathTimer = 0;
    g_medalTimer = 0;
    g_scorePopupTimer = 0;
    g_scorePopupValue = 0;
}

void StartGame() {
    ResetGame();
    g_state = STATE_PLAYING;
    g_bird.flap();

    if (g_stats.totalGames == 0) g_stats.firstPlayed = time(nullptr);
    g_stats.totalGames++;
    g_stats.lastPlayed = time(nullptr);

    PlaySoundFlap();
    SpawnFlapParticles(g_bird.x, g_bird.y);
}

void GameOver() {
    g_state = STATE_DYING;
    g_bird.alive = false;
    g_deathTimer = 0;
    g_stats.totalDeaths++;

    PlaySoundDie();
    ShakeScreen(8.0f, 0.5f);
    SpawnCrashParticles(g_bird.x, g_bird.y);

    if (g_score > g_bestScore) {
        g_bestScore = g_score;
        g_stats.bestScore = g_bestScore;
    }
    if (g_score > 0) AddScoreToHistory(g_score);
}

// ============================================================
// ОБНОВЛЕНИЕ
// ============================================================
void UpdateGame(float dt) {
    g_animTimer += dt;

    UpdateClouds(dt);
    UpdateParticles(dt);

    if (g_flashTimer > 0) g_flashTimer -= dt;
    if (g_shakeTimer > 0) {
        g_shakeTimer -= dt;
        if (g_shakeTimer <= 0) g_shakeIntensity = 0;
    }
    if (g_scorePopupTimer > 0) g_scorePopupTimer -= dt;

    switch (g_state) {
        case STATE_PLAYING:
            UpdateGameplay(dt);
            break;
        case STATE_DYING:
            g_deathTimer += dt;
            g_bird.vy += GRAVITY * dt * 60.0f;
            if (g_bird.vy > MAX_FALL_SPEED) g_bird.vy = MAX_FALL_SPEED;
            g_bird.y += g_bird.vy * dt * 60.0f;
            g_bird.rotation += 0.15f * dt * 60.0f;
            if (g_bird.rotation > 1.57f) g_bird.rotation = 1.57f;

            if (g_bird.y + BIRD_H / 2 > GAME_H - GROUND_HEIGHT) {
                g_bird.y = GAME_H - GROUND_HEIGHT - BIRD_H / 2;
                g_bird.vy = 0;
                if (g_deathTimer > 1.0f) {
                    g_state = STATE_GAME_OVER;
                    g_medalTimer = 0;
                }
            }
            break;
        case STATE_GAME_OVER:
            g_medalTimer += dt;
            break;
    }
}

void UpdateGameplay(float dt) {
    UpdateBird(dt);
    UpdatePipes(dt);

    g_pipeTimer += dt;
    float spawnTime = PIPE_SPAWN_TIME / g_gameSpeed;
    if (g_pipeTimer > spawnTime) {
        g_pipeTimer = 0;
        SpawnPipe();
    }

    CheckCollisions();
    CheckScore();

    g_gameSpeed = 1.0f + (float)g_score * 0.02f;
    if (g_gameSpeed > 2.0f) g_gameSpeed = 2.0f;

    g_groundOffset += PIPE_SPEED * g_gameSpeed * dt * 60.0f;
    if (g_groundOffset > 24.0f) g_groundOffset -= 24.0f;
}

void UpdateBird(float dt) {
    g_bird.update(dt);
    if (g_bird.y < BIRD_H / 2) {
        g_bird.y = BIRD_H / 2;
        g_bird.vy = 0;
    }
}

void UpdatePipes(float dt) {
    for (int i = (int)g_pipes.size() - 1; i >= 0; i--) {
        g_pipes[i].x -= PIPE_SPEED * g_gameSpeed * dt * 60.0f;
        if (g_pipes[i].x + PIPE_WIDTH < -50) {
            g_pipes.erase(g_pipes.begin() + i);
        }
    }
}

void UpdateParticles(float dt) {
    for (int i = (int)g_particles.size() - 1; i >= 0; i--) {
        g_particles[i].life -= dt;
        if (g_particles[i].life <= 0) {
            g_particles.erase(g_particles.begin() + i);
            continue;
        }
        g_particles[i].x += g_particles[i].vx * dt * 60.0f;
        g_particles[i].y += g_particles[i].vy * dt * 60.0f;
        g_particles[i].vy += 0.15f * dt * 60.0f;
    }
}

void UpdateClouds(float dt) {
    for (auto& c : g_clouds) {
        c.x -= c.speed * dt * 60.0f;
        if (c.x + 100 < 0) {
            c.x = (float)GAME_W + 50;
            c.y = 40.0f + (float)(rand() % 200);
        }
    }
}

// ============================================================
// СПАВН И КОЛЛИЗИИ
// ============================================================
void SpawnPipe() {
    Pipe p;
    p.x = (float)GAME_W;

    float minGapY = 100.0f + PIPE_GAP / 2;
    float maxGapY = GAME_H - GROUND_HEIGHT - 100.0f - PIPE_GAP / 2;
    if (maxGapY < minGapY) maxGapY = minGapY + 50;

    p.gapY = minGapY + (float)(rand() % (int)(maxGapY - minGapY));
    g_pipes.push_back(p);

    g_stats.totalPipes++;
}

void CheckCollisions() {
    if (g_bird.y - BIRD_H / 2 <= 0) {
        GameOver();
        return;
    }

    if (g_bird.y + BIRD_H / 2 >= GAME_H - GROUND_HEIGHT) {
        GameOver();
        return;
    }

    float bx = g_bird.x - BIRD_W / 2 + 4;
    float by = g_bird.y - BIRD_H / 2 + 4;
    float bw = BIRD_W - 8;
    float bh = BIRD_H - 8;

    for (auto& p : g_pipes) {
        if (p.x > bx + bw || p.x + PIPE_WIDTH < bx) continue;

        float topH = p.gapY - PIPE_GAP / 2;
        float bottomStart = p.gapY + PIPE_GAP / 2;

        if (topH > 0 && by < topH) {
            GameOver();
            return;
        }
        if (bottomStart < GAME_H - GROUND_HEIGHT && by + bh > bottomStart) {
            GameOver();
            return;
        }
    }
}

void CheckScore() {
    for (auto& p : g_pipes) {
        if (p.scored) continue;
        if (p.x + PIPE_WIDTH / 2 < g_bird.x) {
            p.scored = true;
            g_score++;

            PlaySoundScore();
            SpawnScoreParticles(g_bird.x + 40, g_bird.y);
            ShakeScreen(2.0f, 0.1f);

            g_scorePopupTimer = 0.8f;
            g_scorePopupValue = g_score;
            g_flashTimer = 0.1f;
        }
    }
}

void HandleFlap() {
    if (g_state == STATE_MENU) {
        StartGame();
        return;
    }
    if (g_state == STATE_PLAYING) {
        g_bird.flap();
        g_stats.totalFlaps++;
        PlaySoundFlap();
        SpawnFlapParticles(g_bird.x, g_bird.y);
    }
    if (g_state == STATE_GAME_OVER && g_medalTimer > 0.8f) {
        StartGame();
    }
}

