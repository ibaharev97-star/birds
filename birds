void SpawnFlapParticles(float x, float y) {
    if (!g_settings.particlesEnabled) return;
    for (int i = 0; i < 6; i++) {
        Particle p;
        p.x = x - BIRD_W / 4;
        p.y = y + 10;
        p.vx = -2.0f - (rand() % 100) / 50.0f;
        p.vy = ((rand() % 100) - 50) / 30.0f;
        p.life = 0.5f;
        p.maxLife = 0.5f;
        p.size = 3.0f;
        p.color = GetBirdColor(g_bird.color, 1);
        p.type = 0;
        g_particles.push_back(p);
    }
}

void SpawnScoreParticles(float x, float y) {
    if (!g_settings.particlesEnabled) return;
    for (int i = 0; i < 12; i++) {
        Particle p;
        p.x = x;
        p.y = y;
        float angle = (rand() % 360) * 3.14159f / 180.0f;
        float speed = 1.0f + (rand() % 100) / 50.0f;
        p.vx = cosf(angle) * speed;
        p.vy = sinf(angle) * speed - 1.0f;
        p.life = 0.8f;
        p.maxLife = 0.8f;
        p.size = 4.0f;
        p.color = RGB(255, 220, 80);
        p.type = 1;
        g_particles.push_back(p);
    }
}

void SpawnCrashParticles(float x, float y) {
    if (!g_settings.particlesEnabled) return;
    for (int i = 0; i < 25; i++) {
        Particle p;
        p.x = x;
        p.y = y;
        float angle = (rand() % 360) * 3.14159f / 180.0f;
        float speed = 2.0f + (rand() % 200) / 50.0f;
        p.vx = cosf(angle) * speed;
        p.vy = sinf(angle) * speed;
        p.life = 1.2f;
        p.maxLife = 1.2f;
        p.size = 5.0f;
        int cc = rand() % 3;
        if (cc == 0) p.color = GetBirdColor(g_bird.color, 0);
        else if (cc == 1) p.color = GetBirdColor(g_bird.color, 1);
        else p.color = RGB(255, 255, 255);
        p.type = 2;
        g_particles.push_back(p);
    }
}

void ShakeScreen(float intensity, float duration) {
    if (!g_settings.shakeEnabled) return;
    g_shakeIntensity = intensity;
    g_shakeTimer = duration;
}

