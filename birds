wstring GetDataPath() {
    wchar_t path[MAX_PATH];
    GetModuleFileNameW(nullptr, path, MAX_PATH);
    wstring s = path;
    size_t pos = s.find_last_of(L"\\/");
    if (pos != wstring::npos) s = s.substr(0, pos + 1);
    return s + L"flappy_data.txt";
}

wstring FormatDate(time_t t) {
    tm ti;
    localtime_s(&ti, &t);
    wchar_t buf[64];
    swprintf(buf, 64, L"%02d.%02d.%04d %02d:%02d",
        ti.tm_mday, ti.tm_mon + 1, ti.tm_year + 1900,
        ti.tm_hour, ti.tm_min);
    return buf;
}

void LoadSettings() {
    wstring path = GetDataPath();
    FILE* f = nullptr;
    _wfopen_s(&f, path.c_str(), L"r, ccs=UTF-8");
    if (!f) return;

    wchar_t line[512];
    while (fgetws(line, 512, f)) {
        wstring s = line;
        while (!s.empty() && (s.back() == L'\n' || s.back() == L'\r'))
            s.pop_back();
        if (s.empty() || s[0] == L'#') continue;

        size_t eq = s.find(L'=');
        if (eq == wstring::npos) continue;

        wstring key = s.substr(0, eq);
        wstring val = s.substr(eq + 1);

        if (key == L"birdColor") g_settings.birdColor = _wtoi(val.c_str());
        else if (key == L"sound") g_settings.soundEnabled = _wtoi(val.c_str()) != 0;
        else if (key == L"particles") g_settings.particlesEnabled = _wtoi(val.c_str()) != 0;
        else if (key == L"shake") g_settings.shakeEnabled = _wtoi(val.c_str()) != 0;
        else if (key == L"difficulty") g_settings.difficulty = _wtoi(val.c_str());
        else if (key == L"best") g_stats.bestScore = _wtoi(val.c_str());
        else if (key == L"games") g_stats.totalGames = _wtoi(val.c_str());
        else if (key == L"flaps") g_stats.totalFlaps = _wtoi(val.c_str());
        else if (key == L"pipes") g_stats.totalPipes = _wtoi(val.c_str());
        else if (key == L"deaths") g_stats.totalDeaths = _wtoi(val.c_str());
    }
    fclose(f);
    g_bestScore = g_stats.bestScore;
}

void SaveSettings() {
    wstring path = GetDataPath();
    FILE* f = nullptr;
    _wfopen_s(&f, path.c_str(), L"w, ccs=UTF-8");
    if (!f) return;

    fwprintf(f, L"# Flappy Bird Deluxe\n");
    fwprintf(f, L"birdColor=%d\n", g_settings.birdColor);
    fwprintf(f, L"sound=%d\n", g_settings.soundEnabled ? 1 : 0);
    fwprintf(f, L"particles=%d\n", g_settings.particlesEnabled ? 1 : 0);
    fwprintf(f, L"shake=%d\n", g_settings.shakeEnabled ? 1 : 0);
    fwprintf(f, L"difficulty=%d\n", g_settings.difficulty);
    fwprintf(f, L"best=%d\n", g_stats.bestScore);
    fwprintf(f, L"games=%d\n", g_stats.totalGames);
    fwprintf(f, L"flaps=%d\n", g_stats.totalFlaps);
    fwprintf(f, L"pipes=%d\n", g_stats.totalPipes);
    fwprintf(f, L"deaths=%d\n", g_stats.totalDeaths);

    fclose(f);
}

void AddScoreToHistory(int score) {
    ScoreEntry e;
    e.score = score;
    e.date = time(nullptr);
    g_stats.history.push_back(e);
    if (g_stats.history.size() > 50) {
        g_stats.history.erase(g_stats.history.begin());
    }
}

