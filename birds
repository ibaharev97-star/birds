void UpdateHoverStates() {
    g_hoverPlay = false;
    g_hoverRestart = false;
    g_hoverMenu = false;
    g_hoverSettings = false;
    g_hoverSkinLeft = false;
    g_hoverSkinRight = false;
    g_hoverDiffLeft = false;
    g_hoverDiffRight = false;

    int mx = g_mouseX - GAME_X;
    int my = g_mouseY - GAME_Y;
    if (mx < -50 || mx > GAME_W + 50) return;

    if (g_state == STATE_MENU && !g_showSettings) {
        int bw = 240, bh = 60;
        int bx = (GAME_W - bw) / 2;
        int by = 350;
        if (mx >= bx && mx <= bx + bw && my >= by && my <= by + bh)
            g_hoverPlay = true;

        int sw = 180, sh = 50;
        int sx = (GAME_W - sw) / 2;
        int sy = by + bh + 25;
        if (mx >= sx && mx <= sx + sw && my >= sy && my <= sy + sh)
            g_hoverSettings = true;
    }

    if (g_state == STATE_GAME_OVER && g_medalTimer > 0.8f) {
        int panelW = 320, panelH = 420;
        int panelX = (GAME_W - panelW) / 2;
        int panelY = 100;
        int bw = 220, bh = 55;
        int bx = panelX + (panelW - bw) / 2;
        int by = panelY + panelH - 80;

        if (mx >= bx && mx <= bx + bw && my >= by && my <= by + bh)
            g_hoverRestart = true;

        int mw = 220, mh = 40;
        int mx2 = panelX + (panelW - mw) / 2;
        int my2 = by + bh + 12;
        if (mx >= mx2 && mx <= mx2 + mw && my >= my2 && my <= my2 + mh)
            g_hoverMenu = true;
    }

    if (g_showSettings) {
        int panelW = 380, panelH = 520;
        int panelX = (GAME_W - panelW) / 2;
        int panelY = 50;

        int bw = 200, bh = 50;
        int bx = panelX + (panelW - bw) / 2;
        int by = panelY + panelH - 70;
        if (mx >= bx && mx <= bx + bw && my >= by && my <= by + bh)
            g_hoverMenu = true;

        int cy = panelY + 80 + 32 + 40;
        int cx = panelX + panelW / 2 - 40;
        if (mx >= cx - 60 && mx <= cx - 20 && my >= cy - 20 && my <= cy + 20)
            g_hoverSkinLeft = true;
        if (mx >= cx + 20 && mx <= cx + 60 && my >= cy - 20 && my <= cy + 20)
            g_hoverSkinRight = true;

        int cy2 = cy + 55 + 40 + 20;
        int cx2 = panelX + panelW / 2;
        if (mx >= cx2 - 120 && mx <= cx2 - 80 && my >= cy2 - 20 && my <= cy2 + 20)
            g_hoverDiffLeft = true;
        if (mx >= cx2 + 80 && mx <= cx2 + 120 && my >= cy2 - 20 && my <= cy2 + 20)
            g_hoverDiffRight = true;
    }
}

void OnMouseClick(int x, int y) {
    int mx = x - GAME_X;
    int my = y - GAME_Y;

    if (g_showSettings) {
        int panelW = 380, panelH = 520;
        int panelX = (GAME_W - panelW) / 2;
        int panelY = 50;

        int bw = 200, bh = 50;
        int bx = panelX + (panelW - bw) / 2;
        int by = panelY + panelH - 70;
        if (mx >= bx && mx <= bx + bw && my >= by && my <= by + bh) {
            g_showSettings = false;
            SaveSettings();
            return;
        }

        int cy = panelY + 80 + 32 + 40;
        int cx = panelX + panelW / 2 - 40;
        if (mx >= cx - 60 && mx <= cx - 20 && my >= cy - 20 && my <= cy + 20) {
            g_settings.birdColor--;
            if (g_settings.birdColor < 0) g_settings.birdColor = BIRD_COUNT - 1;
            g_bird.color = g_settings.birdColor;
            Beep(700, 30);
            return;
        }
        if (mx >= cx + 20 && mx <= cx + 60 && my >= cy - 20 && my <= cy + 20) {
            g_settings.birdColor = (g_settings.birdColor + 1) % BIRD_COUNT;
            g_bird.color = g_settings.birdColor;
            Beep(700, 30);
            return;
        }

        int cy2 = cy + 55 + 40 + 20;
        int cx2 = panelX + panelW / 2;
        if (mx >= cx2 - 120 && mx <= cx2 - 80 && my >= cy2 - 20 && my <= cy2 + 20) {
            g_settings.difficulty--;
            if (g_settings.difficulty < 0) g_settings.difficulty = 2;
            Beep(600, 30);
            return;
        }
        if (mx >= cx2 + 80 && mx <= cx2 + 120 && my >= cy2 - 20 && my <= cy2 + 20) {
            g_settings.difficulty = (g_settings.difficulty + 1) % 3;
            Beep(600, 30);
            return;
        }

        int y = panelY + 80;
        int rowH = 55;
        y += rowH + 30;
        y += rowH + 40;
        int togglesY = y;
        for (int i = 0; i < 3; i++) {
            int ty = togglesY + i * 40;
            int tx1 = panelX + panelW - 110;
            int tx2 = panelX + panelW - 30;
            if (mx >= tx1 && mx <= tx2 && my >= ty + 5 && my <= ty + 30) {
                if (i == 0) g_settings.soundEnabled = !g_settings.soundEnabled;
                else if (i == 1) g_settings.particlesEnabled = !g_settings.particlesEnabled;
                else if (i == 2) g_settings.shakeEnabled = !g_settings.shakeEnabled;
                Beep(800, 30);
                return;
            }
        }
        return;
    }

    if (g_state == STATE_MENU) {
        int bw = 240, bh = 60;
        int bx = (GAME_W - bw) / 2;
        int by = 350;
        if (mx >= bx && mx <= bx + bw && my >= by && my <= by + bh) {
            StartGame();
            return;
        }

        int sw = 180, sh = 50;
        int sx = (GAME_W - sw) / 2;
        int sy = by + bh + 25;
        if (mx >= sx && mx <= sx + sw && my >= sy && my <= sy + sh) {
            g_showSettings = true;
            Beep(700, 30);
            return;
        }

        if (mx >= 0 && mx <= GAME_W && my >= 0 && my <= GAME_H) {
            StartGame();
            return;
        }
    }

    if (g_state == STATE_PLAYING) {
        HandleFlap();
        return;
    }

    if (g_state == STATE_GAME_OVER && g_medalTimer > 0.8f) {
        int panelW = 320, panelH = 420;
        int panelX = (GAME_W - panelW) / 2;
        int panelY = 100;
        int bw = 220, bh = 55;
        int bx = panelX + (panelW - bw) / 2;
        int by = panelY + panelH - 80;
        if (mx >= bx && mx <= bx + bw && my >= by && my <= by + bh) {
            StartGame();
            return;
        }

        int mw = 220, mh = 40;
        int mx2 = panelX + (panelW - mw) / 2;
        int my2 = by + bh + 12;
        if (mx >= mx2 && mx <= mx2 + mw && my >= my2 && my <= my2 + mh) {
            g_state = STATE_MENU;
            ResetGame();
            return;
        }
    }

    if (g_state == STATE_PAUSED) {
        g_state = STATE_PLAYING;
        return;
    }
}

void OnKeyPressed(int vk) {
    switch (vk) {
        case VK_SPACE:
            if (g_state == STATE_MENU) StartGame();
            else if (g_state == STATE_PLAYING) HandleFlap();
            else if (g_state == STATE_GAME_OVER && g_medalTimer > 0.8f) StartGame();
            break;
        case VK_RETURN:
            if (g_state == STATE_MENU) StartGame();
            else if (g_state == STATE_GAME_OVER && g_medalTimer > 0.8f) StartGame();
            break;
        case 'P':
            if (g_state == STATE_PLAYING) g_state = STATE_PAUSED;
            else if (g_state == STATE_PAUSED) g_state = STATE_PLAYING;
            break;
        case VK_ESCAPE:
            if (g_showSettings) { g_showSettings = false; SaveSettings(); }
            else if (g_state == STATE_PLAYING || g_state == STATE_PAUSED || g_state == STATE_GAME_OVER) {
                g_state = STATE_MENU; ResetGame();
            } else PostMessageW(g_hwnd, WM_CLOSE, 0, 0);
            break;
        case 'R':
            if (g_state == STATE_GAME_OVER || g_state == STATE_PLAYING) StartGame();
            break;
        case VK_F1:
            g_showSettings = !g_showSettings;
            break;
        case VK_F2:
            g_settings.soundEnabled = !g_settings.soundEnabled;
            break;
        case VK_F5:
            StartGame();
            break;
    }
}

void Tick(float dt) {
    UpdateGame(dt);
    UpdateHoverStates();
}

void OnResize(int w, int h) {
    if (w < 100) w = 100;
    if (h < 100) h = 100;

    if (g_memBitmap) DeleteObject(g_memBitmap);
    if (g_memDC) DeleteDC(g_memDC);

    g_memW = w;
    g_memH = h;

    HDC hdc = GetDC(g_hwnd);
    g_memDC = CreateCompatibleDC(hdc);

    BITMAPINFO bmi = {};
    bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
    bmi.bmiHeader.biWidth = w;
    bmi.bmiHeader.biHeight = -h;
    bmi.bmiHeader.biPlanes = 1;
    bmi.bmiHeader.biBitCount = 32;
    bmi.bmiHeader.biCompression = BI_RGB;

    void* bits = nullptr;
    g_memBitmap = CreateDIBSection(hdc, &bmi, DIB_RGB_COLORS, &bits, nullptr, 0);
    g_pixels = (uint32_t*)bits;

    SelectObject(g_memDC, g_memBitmap);
    ReleaseDC(g_hwnd, hdc);
}

// ============================================================
// WINDOW PROC
// ============================================================
LRESULT CALLBACK WindowProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp) {
    switch (msg) {
        case WM_CREATE:
            return 0;

        case WM_SIZE: {
            int w = LOWORD(lp);
            int h = HIWORD(lp);
            OnResize(w, h);
            return 0;
        }

        case WM_PAINT: {
            PAINTSTRUCT ps;
            HDC hdc = BeginPaint(hwnd, &ps);
            if (g_memDC) {
                RenderFrame();
                BitBlt(hdc, 0, 0, g_memW, g_memH, g_memDC, 0, 0, SRCCOPY);
            }
            EndPaint(hwnd, &ps);
            return 0;
        }

        case WM_ERASEBKGND:
            return 1;

        case WM_TIMER: {
            if (wp == 1) {
                static DWORD lastTick = GetTickCount();
                DWORD now = GetTickCount();
                float dt = (now - lastTick) / 1000.0f;
                lastTick = now;
                if (dt > 0.1f) dt = 0.1f;
                if (dt < 0.001f) dt = 0.016f;
                Tick(dt);
                InvalidateRect(hwnd, nullptr, FALSE);
            }
            return 0;
        }

        case WM_MOUSEMOVE: {
            g_mouseX = GET_X_LPARAM(lp);
            g_mouseY = GET_Y_LPARAM(lp);
            UpdateHoverStates();
            return 0;
        }

        case WM_LBUTTONDOWN: {
            OnMouseClick(GET_X_LPARAM(lp), GET_Y_LPARAM(lp));
            SetCapture(hwnd);
            return 0;
        }

        case WM_LBUTTONUP: {
            ReleaseCapture();
            return 0;
        }

        case WM_RBUTTONDOWN: {
            if (g_state == STATE_PLAYING) g_state = STATE_PAUSED;
            else if (g_state == STATE_PAUSED) g_state = STATE_PLAYING;
            else if (g_state == STATE_GAME_OVER) StartGame();
            return 0;
        }

        case WM_KEYDOWN: {
            if (!g_keys[wp]) {
                g_keys[wp] = true;
                OnKeyPressed((int)wp);
            }
            return 0;
        }

        case WM_KEYUP: {
            g_keys[wp] = false;
            return 0;
        }

        case WM_GETMINMAXINFO: {
            MINMAXINFO* mmi = (MINMAXINFO*)lp;
            mmi->ptMinTrackSize.x = WINDOW_W;
            mmi->ptMinTrackSize.y = WINDOW_H;
            mmi->ptMaxTrackSize.x = WINDOW_W + 200;
            mmi->ptMaxTrackSize.y = WINDOW_H + 200;
            return 0;
        }

        case WM_CLOSE: {
            SaveSettings();
            DestroyWindow(hwnd);
            return 0;
        }

        case WM_DESTROY: {
            KillTimer(hwnd, 1);
            PostQuitMessage(0);
            return 0;
        }
    }
    return DefWindowProcW(hwnd, msg, wp, lp);
}

// ============================================================
// ГЛАВНАЯ ФУНКЦИЯ
// ============================================================
int WINAPI wWinMain(HINSTANCE hInst, HINSTANCE, LPWSTR, int nCmdShow) {
    srand((unsigned)time(nullptr));

    WNDCLASSEXW wc = {};
    wc.cbSize = sizeof(wc);
    wc.style = CS_HREDRAW | CS_VREDRAW | CS_DBLCLKS;
    wc.lpfnWndProc = WindowProc;
    wc.hInstance = hInst;
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.hbrBackground = (HBRUSH)GetStockObject(BLACK_BRUSH);
    wc.lpszClassName = L"FlappyBirdDeluxeClass";
    wc.hIcon = LoadIcon(nullptr, IDI_APPLICATION);

    if (!RegisterClassExW(&wc)) return 1;

    RECT rc = {0, 0, WINDOW_W, WINDOW_H};
    AdjustWindowRect(&rc, WS_OVERLAPPEDWINDOW & ~WS_MAXIMIZEBOX & ~WS_THICKFRAME, FALSE);

    HWND hwnd = CreateWindowExW(
        0, L"FlappyBirdDeluxeClass",
        L"Flappy Bird Deluxe",
        WS_OVERLAPPEDWINDOW & ~WS_MAXIMIZEBOX & ~WS_THICKFRAME,
        CW_USEDEFAULT, CW_USEDEFAULT,
        rc.right - rc.left, rc.bottom - rc.top,
        nullptr, nullptr, hInst, nullptr
    );

    if (!hwnd) return 1;

    InitGame(hwnd);
    ShowWindow(hwnd, nCmdShow);
    UpdateWindow(hwnd);

    MSG msg = {};
    while (GetMessageW(&msg, nullptr, 0, 0)) {
        TranslateMessage(&msg);
        DispatchMessageW(&msg);
    }

    ShutdownGame();
    return (int)msg.wParam;
}
