struct Bird {
    float x, y, vy, rotation, wingTimer;
    int wingFrame, color;
    bool alive;

    Bird() : x(BIRD_X), y(GAME_H / 2.0f), vy(0), rotation(0),
             wingTimer(0), wingFrame(0), color(BIRD_YELLOW), alive(true) {}

    void reset() {
        x = BIRD_X;
        y = GAME_H / 2.0f - 100.0f;
        vy = 0;
        rotation = 0;
        wingTimer = 0;
        wingFrame = 0;
        alive = true;
    }

    void flap() {
        vy = JUMP_FORCE;
        rotation = -0.5f;
        wingFrame = 0;
        wingTimer = 0;
    }

    void update(float dt) {
        vy += GRAVITY * dt * 60.0f;
        if (vy > MAX_FALL_SPEED) vy = MAX_FALL_SPEED;
        y += vy * dt * 60.0f;

        float targetRot = 0;
        if (vy < 0) targetRot = -0.5f;
        else if (vy > 5) targetRot = 1.2f;
        else targetRot = vy * 0.15f;

        rotation += (targetRot - rotation) * 0.15f * dt * 60.0f;

        wingTimer += dt;
        if (wingTimer > 0.1f) {
            wingTimer = 0;
            wingFrame = (wingFrame + 1) % 3;
        }
    }
};

struct Pipe {
    float x, gapY;
