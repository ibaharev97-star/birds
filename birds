void RenderBackground(HDC hdc) {
    RECT gameRc = {GAME_X, GAME_Y, GAME_X + GAME_W, GAME_Y + GAME_H};
    DrawGradientV(hdc, gameRc, COL_SKY_TOP, COL_SKY_BOTTOM);

    // Солнце
    int sunX = GAME_X + GAME_W - 80;
    int sunY = GAME_Y + 70;
    for (int i = 60; i > 0; i -= 4) {
        int alpha = (60 - i) * 2;
        if (alpha > 80) alpha = 80;
        int r = 255;
        int g = 240 - (60 - i);
        int b = 150 - (60 - i) * 2;
        if (g < 200) g = 200;
        if (b < 100) b = 100;
        DrawCircle(hdc, sunX, sunY, i, RGB(r, g, b));
    }
    DrawCircle(hdc, sunX, sunY, 40, RGB(255, 245, 200));
    DrawCircle(hdc, sunX, sunY, 32, RGB(255, 250, 220));

    // Облака
    for (auto& c : g_clouds) {
        int cx = GAME_X + (int)c.x;
        int cy = GAME_Y + (int)c.y;
        int size = (int)(30 * c.size);

        COLORREF cloudCol;
        if (c.layer == 0) cloudCol = RGB(230, 240, 250);
        else if (c.layer == 1) cloudCol = RGB(240, 245, 255);
        else cloudCol = RGB(255, 255, 255);

        DrawCircle(hdc, cx, cy, size, cloudCol);
        DrawCircle(hdc, cx - size, cy + size / 2, size * 3 / 4, cloudCol);
        DrawCircle(hdc, cx + size, cy + size / 2, size * 3 / 4, cloudCol);
        DrawCircle(hdc, cx - size / 2, cy - size / 2, size * 2 / 3, cloudCol);
        DrawCircle(hdc, cx + size / 2, cy - size / 2, size * 2 / 3, cloudCol);
    }
}

void RenderGround(HDC hdc) {
    int groundY = GAME_Y + GAME_H - (int)GROUND_HEIGHT;
    RECT groundRc = {GAME_X, groundY, GAME_X + GAME_W, GAME_Y + GAME_H};
    DrawFilledRect(hdc, groundRc, COL_GROUND);

    RECT grassRc = {GAME_X, groundY, GAME_X + GAME_W, groundY + 15};
    DrawFilledRect(hdc, grassRc, COL_BUSH);

    RECT darkRc = {GAME_X, groundY + 15, GAME_X + GAME_W, groundY + 18};
    DrawFilledRect(hdc, darkRc, COL_GROUND_DARK);

    int tileSize = 24;
    int offset = (int)g_groundOffset % tileSize;
    for (int x = GAME_X - offset; x < GAME_X + GAME_W; x += tileSize) {
        for (int y = groundY + 18; y < GAME_Y + GAME_H; y += tileSize) {
            int cx = (x - GAME_X) / tileSize;
            int cy = (y - groundY) / tileSize;
            if ((cx + cy) % 2 == 0) {
                RECT t = {x, y, x + tileSize, y + tileSize};
                if (t.left < GAME_X) t.left = GAME_X;
                if (t.right > GAME_X + GAME_W) t.right = GAME_X + GAME_W;
                if (t.top < groundY + 18) t.top = groundY + 18;
                if (t.bottom > GAME_Y + GAME_H) t.bottom = GAME_Y + GAME_H;
                DrawFilledRect(hdc, t, COL_GROUND_DARK);
            }
        }
    }

    for (auto& b : g_bushes) {
        int bx = GAME_X + (int)b.x;
        int by = GAME_Y + (int)b.y;
        int size = (int)(15 * b.size);
        if (bx < GAME_X - 50 || bx > GAME_X + GAME_W + 50) continue;

        COLORREF bushCol = COL_BUSH;
        if (b.type == 1) bushCol = RGB(110, 180, 60);
        else if (b.type == 2) bushCol = RGB(80, 160, 45);

        DrawCircle(hdc, bx, by, size, bushCol);
        DrawCircle(hdc, bx - size, by + 5, size * 2 / 3, bushCol);
        DrawCircle(hdc, bx + size, by + 5, size * 2 / 3, bushCol);
    }
}

void RenderPipes(HDC hdc) {
    for (auto& p : g_pipes) {
        int px = GAME_X + (int)p.x;
        int topH = (int)(p.gapY - PIPE_GAP / 2);
        int bottomY = (int)(p.gapY + PIPE_GAP / 2);
        int bottomH = GAME_H - (int)GROUND_HEIGHT - bottomY;
        int pw = (int)PIPE_WIDTH;

        if (px + pw < GAME_X || px > GAME_X + GAME_W) continue;

        // Верхняя труба
        if (topH > 0) {
            int pipeTop = GAME_Y;
            int pipeBottom = GAME_Y + topH;

            RECT bodyRc = {px, pipeTop, px + pw, pipeBottom};
            DrawGradientV(hdc, bodyRc, COL_PIPE_LIGHT, COL_PIPE);

            RECT leftShadow = {px, pipeTop, px + 6, pipeBottom};
            DrawFilledRect(hdc, leftShadow, COL_PIPE_DARK);

            RECT rightShadow = {px + pw - 6, pipeTop, px + pw, pipeBottom};
            DrawFilledRect(hdc, rightShadow, COL_PIPE_DARK);

            RECT highlight = {px + 12, pipeTop, px + 20, pipeBottom};
            DrawFilledRect(hdc, highlight, COL_PIPE_LIGHT);

            int capH = 28;
            int capOver = 5;
            RECT capRc = {px - capOver, pipeBottom - capH, px + pw + capOver, pipeBottom};
            DrawGradientV(hdc, capRc, COL_PIPE_LIGHT, COL_PIPE);

            RECT capLeftShadow = {px - capOver, pipeBottom - capH, px - capOver + 6, pipeBottom};
            DrawFilledRect(hdc, capLeftShadow, COL_PIPE_DARK);

            RECT capRightShadow = {px + pw + capOver - 6, pipeBottom - capH, px + pw + capOver, pipeBottom};
            DrawFilledRect(hdc, capRightShadow, COL_PIPE_DARK);

            HBRUSH ob = (HBRUSH)SelectObject(hdc, GetStockObject(NULL_BRUSH));
            HPEN pen = CreatePen(PS_SOLID, 2, COL_PIPE_DARK);
            HGDIOBJ op = SelectObject(hdc, pen);
            Rectangle(hdc, capRc.left, capRc.top, capRc.right, capRc.bottom);
            SelectObject(hdc, ob);
            SelectObject(hdc, op);
            DeleteObject(pen);

            RECT capHighlight = {px + 8, pipeBottom - capH + 4, px + 22, pipeBottom - 4};
            DrawFilledRect(hdc, capHighlight, RGB(200, 240, 150));
        }

        // Нижняя труба
        if (bottomH > 0) {
            int pipeTop = GAME_Y + bottomY;
            int pipeBottom = GAME_Y + GAME_H - (int)GROUND_HEIGHT;

            RECT bodyRc = {px, pipeTop, px + pw, pipeBottom};
            DrawGradientV(hdc, bodyRc, COL_PIPE_LIGHT, COL_PIPE);

            RECT leftShadow = {px, pipeTop, px + 6, pipeBottom};
            DrawFilledRect(hdc, leftShadow, COL_PIPE_DARK);

            RECT rightShadow = {px + pw - 6, pipeTop, px + pw, pipeBottom};
            DrawFilledRect(hdc, rightShadow, COL_PIPE_DARK);

            RECT highlight = {px + 12, pipeTop, px + 20, pipeBottom};
            DrawFilledRect(hdc, highlight, COL_PIPE_LIGHT);

            int capH = 28;
            int capOver = 5;
            RECT capRc = {px - capOver, pipeTop, px + pw + capOver, pipeTop + capH};
            DrawGradientV(hdc, capRc, COL_PIPE_LIGHT, COL_PIPE);

            RECT capLeftShadow = {px - capOver, pipeTop, px - capOver + 6, pipeTop + capH};
            DrawFilledRect(hdc, capLeftShadow, COL_PIPE_DARK);

            RECT capRightShadow = {px + pw + capOver - 6, pipeTop, px + pw + capOver, pipeTop + capH};
            DrawFilledRect(hdc, capRightShadow, COL_PIPE_DARK);

            HBRUSH ob = (HBRUSH)SelectObject(hdc, GetStockObject(NULL_BRUSH));
            HPEN pen = CreatePen(PS_SOLID, 2, COL_PIPE_DARK);
            HGDIOBJ op = SelectObject(hdc, pen);
            Rectangle(hdc, capRc.left, capRc.top, capRc.right, capRc.bottom);
            SelectObject(hdc, ob);
            SelectObject(hdc, op);
            DeleteObject(pen);

            RECT capHighlight = {px + 8, pipeTop + 4, px + 22, pipeTop + capH - 4};
            DrawFilledRect(hdc, capHighlight, RGB(200, 240, 150));
        }
    }
}

void RenderBird(HDC hdc) {
    int bx = GAME_X + (int)g_bird.x;
    int by = GAME_Y + (int)g_bird.y;

    XFORM xf;
    xf.eM11 = cosf(g_bird.rotation);
    xf.eM12 = sinf(g_bird.rotation);
    xf.eM21 = -sinf(g_bird.rotation);
    xf.eM22 = cosf(g_bird.rotation);
    xf.eDx = (FLOAT)bx;
    xf.eDy = (FLOAT)by;

    int saved = SaveDC(hdc);
    SetGraphicsMode(hdc, GM_ADVANCED);
    SetWorldTransform(hdc, &xf);

    int bw = (int)BIRD_W;
    int bh = (int)BIRD_H;

    COLORREF bodyNorm = GetBirdColor(g_bird.color, 0);
    COLORREF bodyLight = GetBirdColor(g_bird.color, 1);
    COLORREF bodyDark = GetBirdColor(g_bird.color, 2);

    // Тело
    DrawEllipseRect(hdc, {-bw/2, -bh/2, bw/2, bh/2}, bodyNorm);
    DrawEllipseRect(hdc, {-bw/4, -bh/2 + 3, bw/3, bh/6}, bodyLight);
    DrawEllipseRect(hdc, {-bw/4, bh/4, bw/3, bh/2 - 3}, bodyDark);

    // Крыло
    int wingOffset = 0;
    if (g_state == STATE_PLAYING || g_state == STATE_DYING) {
        if (g_bird.wingFrame == 0) wingOffset = -6;
        else if (g_bird.wingFrame == 1) wingOffset = 0;
        else wingOffset = 4;
    } else wingOffset = -3;

    RECT wingRc = {-bw/3, -bh/4 + wingOffset, bw/4, bh/4 + wingOffset};
    DrawEllipseRect(hdc, wingRc, bodyDark);

    RECT wingInner = {-bw/3 + 3, -bh/4 + wingOffset + 3, bw/4 - 3, bh/4 + wingOffset - 3};
    DrawEllipseRect(hdc, wingInner, bodyLight);

    // Глаз
    int eyeX = bw/4;
    int eyeY = -bh/6;
    DrawCircle(hdc, eyeX, eyeY, 7, RGB(255, 255, 255));
    DrawCircle(hdc, eyeX + 2, eyeY, 4, RGB(30, 30, 30));
    DrawCircle(hdc, eyeX + 1, eyeY - 2, 1, RGB(255, 255, 255));

    // Клюв
    RECT beakUpper = {bw/2 - 4, -bh/8, bw/2 + 14, bh/8};
    DrawEllipseRect(hdc, beakUpper, RGB(255, 140, 30));

    RECT beakLower = {bw/2 - 4, 2, bw/2 + 12, bh/4};
    DrawEllipseRect(hdc, beakLower, RGB(230, 100, 20));

    RECT beakLine = {bw/2 - 4, 0, bw/2 + 14, 3};
    DrawFilledRect(hdc, beakLine, RGB(180, 70, 10));

    // Хвост
    RECT tailRc = {-bw/2 - 8, -bh/8, -bw/2 + 4, bh/8};
    DrawEllipseRect(hdc, tailRc, bodyDark);

    RestoreDC(hdc, saved);
}

void RenderParticles(HDC hdc) {
    if (!g_settings.particlesEnabled) return;

    for (auto& p : g_particles) {
        float t = p.life / p.maxLife;
        int alpha = (int)(t * 255);
        if (alpha < 0) alpha = 0;
        if (alpha > 255) alpha = 255;

        int px = GAME_X + (int)p.x;
        int py = GAME_Y + (int)p.y;
        int size = (int)(p.size * t);
        if (size < 1) size = 1;

        COLORREF bg = COL_SKY_BOTTOM;
        int r = (GetRValue(p.color) * alpha + GetRValue(bg) * (255 - alpha)) / 255;
        int g = (GetGValue(p.color) * alpha + GetGValue(bg) * (255 - alpha)) / 255;
        int b = (GetBValue(p.color) * alpha + GetBValue(bg) * (255 - alpha)) / 255;
        COLORREF c = RGB(r, g, b);

        if (p.type == 1) {
            for (int dy = -size; dy <= size; dy++) {
                int w = size - abs(dy);
                RECT row = {px - w, py + dy, px + w + 1, py + dy + 1};
                DrawFilledRect(hdc, row, c);
            }
        } else if (p.type == 2) {
            RECT pr = {px - size, py - size, px + size, py + size};
            DrawFilledRect(hdc, pr, c);
        } else {
            DrawCircle(hdc, px, py, size, c);
        }
    }
}

void RenderScore(HDC hdc) {
    if (g_state != STATE_PLAYING && g_state != STATE_DYING &&
        g_state != STATE_PAUSED) return;

    wstring s = to_wstring(g_score);
    RECT r = {GAME_X, GAME_Y + 40, GAME_X + GAME_W, GAME_Y + 130};

    RECT r4 = r; r4.left -= 2; r4.top -= 2;
    DrawTextC(hdc, r4, s, RGB(80, 60, 40), g_fontScore,
              DT_CENTER | DT_VCENTER | DT_SINGLELINE);
    RECT r5 = r; r5.left += 2; r5.top += 2;
    DrawTextC(hdc, r5, s, RGB(80, 60, 40), g_fontScore,
              DT_CENTER | DT_VCENTER | DT_SINGLELINE);
    DrawTextC(hdc, r, s, RGB(255, 255, 255), g_fontScore,
              DT_CENTER | DT_VCENTER | DT_SINGLELINE);
}

void RenderScorePopup(HDC hdc) {
    if (g_scorePopupTimer <= 0) return;

    float t = 1.0f - (g_scorePopupTimer / 0.8f);
    int offsetY = (int)(-40.0f * t);
    int px = GAME_X + (int)g_bird.x + 60;
    int py = GAME_Y + (int)g_bird.y + offsetY;

    wstring s = L"+" + to_wstring(g_scorePopupValue);
    COLORREF c = RGB(255, (int)(220 * (1.0f - t) + 80 * t), 80);

    RECT r = {px - 60, py - 20, px + 60, py + 20};
    DrawTextC(hdc, r, s, c, g_fontMedium,
              DT_CENTER | DT_VCENTER | DT_SINGLELINE);
}

