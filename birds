void RenderMedal(HDC hdc) {
    int medal = GetMedalType(g_score);
    if (medal == MEDAL_NONE) return;

    float t = g_medalTimer;
    if (t > 1.0f) t = 1.0f;

    int cx = GAME_X + 120;
    int cy = GAME_Y + 320 + (int)((1.0f - t) * 60);
    int radius = (int)(40 * t);
    if (radius < 5) return;

    COLORREF col = GetMedalColor(medal);

    DrawCircle(hdc, cx + 3, cy + 3, radius, RGB(30, 30, 30));
    DrawCircle(hdc, cx, cy, radius, col);

    COLORREF inner = RGB(
        min(255, (int)GetRValue(col) + 40),
        min(255, (int)GetGValue(col) + 40),
        min(255, (int)GetBValue(col) + 40));
    DrawCircle(hdc, cx, cy, radius - 4, inner);

    DrawCircle(hdc, cx - radius / 3, cy - radius / 3, radius / 4, RGB(255, 255, 255));

    int starSize = radius / 2;
    for (int i = -starSize; i <= starSize; i++) {
        int w = starSize - abs(i);
        RECT row = {cx - w, cy + i, cx + w + 1, cy + i + 1};
        DrawFilledRect(hdc, row, col);
    }

    wstring name = GetMedalName(medal);
    RECT nameRc = {cx - 80, cy + radius + 10, cx + 80, cy + radius + 35};
    DrawTextC(hdc, nameRc, name, RGB(255, 255, 255), g_fontBold,
              DT_CENTER | DT_VCENTER | DT_SINGLELINE);
}

void RenderGameOver(HDC hdc) {
    if (g_state != STATE_GAME_OVER) return;

    float t = g_medalTimer;
    if (t > 0.5f) t = 0.5f;
    float alpha = t / 0.5f;

    int dark = (int)(120 * alpha);
    for (int y = 0; y < GAME_H; y++) {
        RECT line = {GAME_X, GAME_Y + y, GAME_X + GAME_W, GAME_Y + y + 1};
        int r = 113 + (180 - 113) * y / GAME_H;
        int g = 197 + (230 - 197) * y / GAME_H;
        int b = 207 + (235 - 207) * y / GAME_H;
        r = (r * (255 - dark)) / 255;
        g = (g * (255 - dark)) / 255;
        b = (b * (255 - dark)) / 255;
        DrawFilledRect(hdc, line, RGB(r, g, b));
    }

    int panelW = 320;
    int panelH = 420;
    int panelX = GAME_X + (GAME_W - panelW) / 2;
    int panelY = GAME_Y + 100;

    float animT = g_medalTimer / 0.5f;
    if (animT > 1.0f) animT = 1.0f;
    int offsetY = (int)((1.0f - animT) * 60);
    panelY += offsetY;

    RECT panelRc = {panelX, panelY, panelX + panelW, panelY + panelH};

    RECT shadowRc = {panelRc.left + 6, panelRc.top + 6, panelRc.right + 6, panelRc.bottom + 6};
    DrawRoundedRect(hdc, shadowRc, 16, RGB(30, 30, 30));
    DrawRoundedRect(hdc, panelRc, 16, COL_UI_PANEL);

    HBRUSH ob = (HBRUSH)SelectObject(hdc, GetStockObject(NULL_BRUSH));
    HPEN pen = CreatePen(PS_SOLID, 3, COL_UI_BORDER);
    HGDIOBJ op = SelectObject(hdc, pen);
    RoundRect(hdc, panelRc.left, panelRc.top, panelRc.right, panelRc.bottom, 16, 16);
    SelectObject(hdc, ob);
    SelectObject(hdc, op);
    DeleteObject(pen);

    RECT titleRc = {panelRc.left, panelRc.top + 20, panelRc.right, panelRc.top + 70};
    DrawTextShadow(hdc, titleRc, L"GAME OVER",
                   RGB(220, 60, 60), RGB(80, 20, 20),
                   g_fontLarge, DT_CENTER | DT_VCENTER | DT_SINGLELINE);

    RenderMedal(hdc);

    RECT scoreLabelRc = {panelRc.left + 20, panelRc.top + 180, panelRc.right - 20, panelRc.top + 210};
    DrawTextC(hdc, scoreLabelRc, L"СЧЁТ", RGB(120, 100, 80), g_fontSmall,
              DT_CENTER | DT_VCENTER | DT_SINGLELINE);

    RECT scoreRc = {panelRc.left + 20, panelRc.top + 205, panelRc.right - 20, panelRc.top + 265};
    DrawTextC(hdc, scoreRc, to_wstring(g_score), RGB(60, 60, 60), g_fontHuge,
              DT_CENTER | DT_VCENTER | DT_SINGLELINE);

    RECT bestLabelRc = {panelRc.left + 20, panelRc.top + 270, panelRc.right - 20, panelRc.top + 295};
    DrawTextC(hdc, bestLabelRc, L"ЛУЧШИЙ", RGB(120, 100, 80), g_fontSmall,
              DT_CENTER | DT_VCENTER | DT_SINGLELINE);

    RECT bestRc = {panelRc.left + 20, panelRc.top + 290, panelRc.right - 20, panelRc.top + 335};
    DrawTextC(hdc, bestRc, to_wstring(g_bestScore), RGB(180, 130, 40), g_fontLarge,
              DT_CENTER | DT_VCENTER | DT_SINGLELINE);

    if (g_medalTimer > 0.8f) {
        int bw = 220, bh = 55;
        int bx = panelX + (panelW - bw) / 2;
        int by = panelY + panelH - 80;

        RECT restartRc = {bx, by, bx + bw, by + bh};
